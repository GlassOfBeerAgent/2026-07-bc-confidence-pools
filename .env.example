# Required: live BattleChain SafeHarborRegistry address.
SAFE_HARBOR_REGISTRY=0x0000000000000000000000000000000000000000

# Required UNLESS DEPLOY_MOCK_MODERATOR=true below.
# The protocol DAO / moderator address, set immutably per-pool at clone time.
DEFAULT_MODERATOR=0x0000000000000000000000000000000000000000

# Optional. Set to true to deploy a fresh permissionless mock moderator
# instead of DEFAULT_MODERATOR. TESTNET ONLY. Default: false.
# DEPLOY_MOCK_MODERATOR=true

# Optional but recommended. Comma-separated stake-token allowlist.
# If unset, the factory ships with an EMPTY allowlist and createPool reverts
# StakeTokenNotAllowed until the owner runs setStakeTokenAllowed post-deploy.
# INITIAL_STAKE_TOKENS=0x...,0x...

# RPC endpoints. foundry.toml maps the battlechain_testnet / battlechain_mainnet
# aliases to these; select one with --rpc-url <alias>, or override with a raw URL.
# The fork tests under test/fork/ resolve battlechain_testnet to BATTLECHAIN_TESTNET_RPC.
BATTLECHAIN_TESTNET_RPC=https://testnet.battlechain.com
BATTLECHAIN_MAINNET_RPC=https://mainnet.battlechain.com

# Signing: do NOT put a private key here. Pass a signer at the command line:
#   forge script script/Deploy.s.sol --rpc-url battlechain_testnet --broadcast --account <keystore>
# or --ledger / --interactive.
